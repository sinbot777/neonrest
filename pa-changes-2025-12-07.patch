+/* post_overrides.css — Cleaned Version 🧹 */
+
+/* Post Preview Container */
+
+.post-preview {
+  position: relative;
+  background: rgb(0 0 0 / 46%);
+  border-left: 4px solid #ffa7c4;
+  border-radius: 12px;
+  padding: 1rem;
+  margin-bottom: 1.5rem;
+  box-shadow: 0 2px 12px rgba(255, 167, 199, 0.2);
+  color: var(--text-color, #fff);
+}
+
+
+/* Guestbook Outbound Specific */
+.post-preview.guestbook-outbound {
+  margin-left: 1cm;
+  background-color: rgb(83 83 83 / 81%);
+  border-left: 15px solid #ff9bc2;
+  padding-left: 1.5rem;
+  box-shadow: 0 0 6px rgba(255, 155, 194, 0.3);
+  border-radius: 0.75em;
+}
+
+/* Post Header */
+.post-header {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 0.75rem;
+  position: relative;
+  font-size: 0.8rem;
+}
+
+.post-user-meta {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+}
+
+/* Reaction Form + Buttons */
+
+.post-reactions-box.react-form {
+  background: rgb(99 159 203);
+  border-radius: 0.5em;
+  padding: 0.25em;
+  margin-top: 0.75em;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.4em;
+  justify-content: flex-end;
+}
+
+
+.react-form {
+  margin-top: 0.5em;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25em 0.3em;  /* smaller row/column spacing */
+  justify-content: flex-end;
+}
+
+.react-form .icon-button {
+  background: none;
+  border: none;
+  cursor: pointer;
+  font-size: 1.1rem;
+  line-height: 1;
+  border-radius: 6px;
+  color: #ffcde9;
+  text-shadow: 0 0 1px black, 0 0 2px black;
+  transition: transform 0.2s ease;
+  margin: 0 -0.15rem;   /* ← Negative margin to pull buttons tighter together */
+  padding: 0;
+  position: relative;
+}
+
+.react-form .icon-button:hover {
+  transform: scale(1.15);
+  color: #fff;
+  text-shadow: 0 0 4px #ffa7c4;
+}
+
+.react-form .icon-button.active {
+  font-weight: bold;
+  text-shadow: 0 0 6px #fff;
+}
+
+.react-btn {
+  background: transparent;
+  border: none;
+  font-size: 1rem;
+  color: var(--text-color, #333);
+  padding: 0.15em 0.0005em;
+  cursor: pointer;
+  border-radius: 6px;
+  transition: background 0.2s, transform 0.2s;
+  text-shadow: 0 0 3px var(--reaction-glow, #ffa7d7);
+  position: relative;
+}
+
+.react-btn sub {
+  position: absolute;
+  bottom: -0.25em;
+  right: -0.4em;
+  font-size: 0.55em;
+  font-weight: bold;
+  color: #333;
+  background: #fff;
+  border-radius: 1em;
+  padding: 0.1em 0.4em;
+  line-height: 1;
+  box-shadow: 0 0 2px rgba(0, 0, 0, 0.2);
+  pointer-events: none;
+}
+
+
+.react-btn:hover {
+  background-color: var(--reaction-hover-bg, rgba(0, 0, 0, 0.1));
+  transform: scale(1.1);
+}
+
+.react-btn.active {
+  color: var(--reaction-active, #fff);
+  text-shadow: 0 0 6px var(--reaction-glow, #ffa7d7);
+  background-color: var(--reaction-hover-bg, rgba(255, 167, 199, 0.1));
+  font-weight: bold;
+  transform: scale(1.15);
+}
+
+/* Post Content */
+.post-content {
+  color: #ffffff;
+  white-space: pre-wrap;
+  margin-bottom: 0.5rem;
+}
+
+/* Post Actions Dropdown */
+.post-actions {
+  position: absolute;
+  top: 8px;
+  right: 8px;
+  z-index: 2;
+}
+
+.post-dropdown {
+  position: absolute;
+  background-color: #222;
+  border: 1px solid #444;
+  border-radius: 5px;
+  padding: 0.5em;
+  right: 0;
+  top: 1.8em;
+  z-index: 10;
+}
+
+.post-dropdown a,
+.post-dropdown button.link-button {
+  display: block;
+  padding: 0.25em 0.5em;
+  color: #fdfdfd;
+  background: none;
+  border: none;
+  text-align: left;
+  width: 100%;
+  text-decoration: none;
+  cursor: pointer;
+}
+
+.post-dropdown a:hover,
+.post-dropdown button.link-button:hover {
+  background-color: #333;
+}
+
+.reply-thread {
+  margin-left: 1.5rem;
+  border-left: 2px dashed var(--accent-color, #ccc);
+  padding-left: 1rem;
+  margin-top: 0.5rem;
+}
+
+.reply-comment .avatar-img.tiny {
+  width: 20px;
+  height: 20px;
+}
+
+.comment-actions {
+  position: absolute;
+  top: 0;
+  right: 0;
+  z-index: 2;
+}
+
+.comment-header {
+  position: relative;
+  display: flex;
+  align-items: center;
+  gap: 0.5em;
+  font-size: 0.8rem;
+}
+
+.comment-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem;
+}
+
+.comment-meta {
+  display: flex;
+  align-items: center;
+  gap: 0.4rem;
+}
+
+.avatar-img.tiny {
+  width: 28px;
+  height: 28px;
+  object-fit: cover;
+  border-radius: 50%;
+  aspect-ratio: 1 / 1;
+}
+
+/* Reply link/button */
+.small-button {
+  display: inline-block;
+  background-color: #4e9ddc;                   /* same blue as “New Post” */
+  color: #fff;                                  /* white text */
+  padding: 0.3rem 0.75rem;                      /* comfortable hit-area */
+  border-radius: 6px;                           /* match your other buttons */
+  font-weight: 600;                             /* bold like the New Post button */
+  font-size: 0.85rem;                           /* slightly smaller than main buttons */
+  text-decoration: none;                        /* no underline */
+  cursor: pointer;
+  transition: background-color 0.3s ease,
+              transform 0.2s ease;
+  margin-top: 0.25rem;                          /* space above comments */
+}
+
+.small-button:hover {
+  background-color: #3a8cb5;                    /* a tad darker on hover */
+  transform: translateY(-1px);                  /* tiny lift effect */
+}
+
+/* Make edit-btn & link-button use the same “small-button” style */
+.edit-btn,
+.link-button {
+  background: none;
+  border: none;
+  padding: 0;
+  margin: 0 0.25em;
+  font-size: 0.9rem;
+  color: var(--accent-color, #4e9ddc);
+  text-decoration: none;
+  cursor: pointer;
+  transition: color 0.2s ease, text-shadow 0.2s ease;
+}
+
+.edit-btn:hover,
+.link-button:hover {
+  color: var(--accent-hover, #6ebff9);
+  text-decoration: underline;
+}
+
+.edit-btn:focus,
+.link-button:focus {
+  outline: none;
+  text-shadow: 0 0 2px var(--accent-hover, #6ebff9);
+}
+
+/* Wrap each comment in a very faint rounded box */
+.comments-section .comment {
+  background: rgba(255,255,255,0.03);
+  border: 1px solid rgba(255,255,255,0.1);
+  border-radius: 6px;
+  padding: 0.75rem;
+  margin: 0.5rem 0;
+}
+
+/* in post_overrides.css */
+
+.post-user-meta strong,
+.comment-meta strong {
+  font-family: 'Space Grotesk', sans-serif;
+  color: #fff8e7;
+  display: block;
+  text-align: center;
+  max-width: 100%;
+  word-break: break-word;
+  /* text-wrap: balance;  — currently only in Safari Technology Preview */
+  white-space: normal;
+  text-shadow: 0 0 10px #fcd9c4, 0 0 20px #fcb5a3;
+  margin-bottom: 0.5rem;
+  font-size: 0.85em;
+}
