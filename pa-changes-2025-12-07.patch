+{% for post in posts %}
+<div class="post-preview{% if post.is_guestbook_outbound %} guestbook-outbound{% endif %}">
+  <div class="post-header">
+    <a href="{{ url_for('user_page_test', user_id=post.user_id) }}">
+      <img src="{{ post.author_avatar or '/static/default-avatar.png' }}" alt="avatar" class="avatar-img small">
+    </a>
+    <div class="post-user-meta">
+      <a href="{{ url_for('user_page_test', user_id=post.user_id) }}">
+        <strong>@{{ post.author_handle }}</strong>
+      </a>
+      {% if post.target_handle %}&rarr; <strong>@{{ post.target_handle }}</strong>{% endif %}
+      <small>{{ post.created_at }}</small>
+      {% if post.last_edited %}<small>(edited {{ post.last_edited }})</small>{% endif %}
+        {# Updated Vibe Links #}
+        {% if post.vibes %}
+          <div class="post-vibes">
+            {% for vibe in post.vibes.split(', ') %}
+              {% set meta = vibe_metadata.get(vibe) %}
+              <a
+                href="{{ url_for('vibe_page', vibe_name=vibe) }}"
+                class="vibe-tag {{ meta.css_class if meta }}"
+                style="{% if meta %}background-color: {{ meta.bg }}; color: {{ meta.text }};{% endif %}"
+              >#{{ vibe }}</a>
+            {% endfor %}
+          </div>
+        {% endif %}
+
+        {% if viewer_id == post.user_id %}
+        <div class="post-actions">
+          <button class="icon-button" onclick="togglePostMenu(this)">⋮</button>
+          <div class="post-dropdown" style="display:none;">
+            <a href="/edit_post/{{ post.id }}" class="link-button">Edit</a>
+            <form method="POST" action="/delete_post/{{ post.id }}" style="display:inline;" onsubmit="return confirm('Delete this post?');">
+              <button type="submit" class="link-button">Delete</button>
+            </form>
+          </div>
+        </div>
+        {% endif %}
+      </div>
+    </div>
+
+  <div class="post-content">{{ post.html_content | safe }}</div>
+
+  <div class="post-reactions-box react-form" data-post-id="{{ post.id }}">
+    {% for emoji in VALID_REACTS %}
+      <button class="react-btn{% if post.reaction_counts.get(emoji) %} active{% endif %}" data-emoji="{{ emoji }}" data-post-id="{{ post.id }}">
+        {{ emoji }}{% if post.reaction_counts.get(emoji) %}<sub>{{ post.reaction_counts.get(emoji) }}</sub>{% endif %}
+      </button>
