+
+  {% if viewer_id %}
+  <div class="comment-form">
+    <form id="comment-form-{{ post.id }}" method="POST" action="/create_comment" data-post-id="{{ post.id }}">
+      <input type="hidden" name="post_id" value="{{ post.id }}">
+      <input type="hidden" name="parent_comment_id" id="parent_comment_id_{{ post.id }}" value="">
+      <input type="text" name="content" placeholder="Leave a comment..." required class="comment-input">
+      <button type="submit" class="comment-submit">Post</button>
+    </form>
+  </div>
+  {% endif %}
+</div>
+{% endfor %}
+
+<script>
+function toggleCommentMenu(btn) {
+  const menu = btn.nextElementSibling;
+  document.querySelectorAll('.comment-dropdown').forEach(el => el.style.display = 'none');
+  menu.style.display = (menu.style.display === 'block' ? 'none' : 'block');
+}
+
+function togglePostMenu(btn) {
+  const menu = btn.nextElementSibling;
+  document.querySelectorAll('.post-dropdown').forEach(el => el.style.display = 'none');
+  menu.style.display = (menu.style.display === 'block' ? 'none' : 'block');
+}
+
+function setReplyTarget(commentId, postId) {
+  const parentInput = document.getElementById(`parent_comment_id_${postId}`);
+  if (parentInput) {
+    parentInput.value = commentId;
+    const contentInput = document.querySelector(`#comment-form-${postId} input[name='content']`);
+    if (contentInput) contentInput.focus();
+  }
+}
+
+async function submitComment(event, form) {
+  event.preventDefault();
+  const formData = new FormData(form);
+  try {
+    const res = await fetch(form.action, { method: 'POST', body: formData });
+    if (!res.ok) throw new Error('Request failed');
+    location.reload();
+  } catch (err) {
+    alert('Error submitting comment'); console.error(err);
+  }
+}
+
+window.addEventListener('DOMContentLoaded', () => {
+  document.querySelectorAll('.comment-form form').forEach(form => {
+    form.addEventListener('submit', e => submitComment(e, form));
+  });
+
+  // Inline edit handlers:
+  document.querySelectorAll('.edit-btn').forEach(btn => {
+    btn.onclick = () => {
+      const container = btn.closest('[data-comment-id]');
+      container.querySelectorAll('.comment-text, .edit-btn').forEach(el => el.style.display='none');
+      container.querySelector('.edit-form').style.display='block';
+    };
+  });
+  document.querySelectorAll('.cancel-btn').forEach(btn => {
+    btn.onclick = () => {
+      const container = btn.closest('[data-comment-id]');
+      container.querySelectorAll('.comment-text, .edit-btn').forEach(el => el.style.display='block');
+      container.querySelector('.edit-form').style.display='none';
+    };
+  });
+  document.querySelectorAll('.save-btn').forEach(btn => {
+    btn.onclick = async e => {
+      e.preventDefault();
+      const container = btn.closest('[data-comment-id]');
+      const commentId = container.dataset.commentId;
+      const content = container.querySelector('textarea').value;
+      try {
+        const res = await fetch(`/edit_comment/${commentId}`, {
+          method: 'POST',
+          headers: {'Content-Type':'application/x-www-form-urlencoded'},
+          body: new URLSearchParams({content})
+        });
+        if (!res.ok) throw new Error('Update failed');
+        container.querySelector('.comment-text').textContent = content;
+        container.querySelectorAll('.comment-text, .edit-btn').forEach(el => el.style.display='block');
+        container.querySelector('.edit-form').style.display='none';
+      } catch(err) {
+        alert('Failed to save'); console.error(err);
+      }
+    };
+  });
+});
+</script>
