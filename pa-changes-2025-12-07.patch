+    db.execute("UPDATE users SET frequent_haunts = ? WHERE id = ?", (new_haunts, session["user_id"]))
+    db.commit()
+    flash("Haunts updated!", "success")
+    return redirect(f"/@{session['user_handle'].lstrip('@')}")
 
